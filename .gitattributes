# Data files
data/**/*.json filter=lfs diff=lfs merge=lfs -text

# Global binary and large data patterns
*.gpx filter=lfs diff=lfs merge=lfs -text
*.csv filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
# All files in the modules directory as requested
modules/**/* filter=lfs diff=lfs merge=lfs -text
# Config files (explicitly non-LFS)
app.json !text !filter !merge !diff
eas.json !text !filter !merge !diff
tsconfig.json !text !filter !merge !diff
package-lock.json !text !filter !merge !diff
