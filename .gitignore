# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Native (Expo Managed)
/ios/
/android/

# Native artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
*.aar
*.jar
temp_aar/

# Metro
.metro-health-check*

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
build.log

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store
*.pem

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Tool-specific
.agents/
notes/
modules/**/build/

# Go/Wasm artifacts (if applicable)
*.wasm
pkg/mobile/mobile.aar
pkg/mobile/mobile-sources.jar
*.txt

# Unignore binaries in modules for Git LFS tracking
!modules/**/*.aar
!modules/**/*.jar
!modules/**/*.wasm
!modules/**/*.so
!modules/**/*.lib
!modules/**/*.dll
!modules/**/*.dylib
debug/

